# Transee backend configuration.
#
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# None of these values may ever be sent to, or embedded in, the mobile app.

# Azure AI Translator credential. Create a Translator resource in the Azure
# portal; the key and region are on its "Keys and Endpoint" page.
# Required unless TRANSLATION_PROVIDER=fake.
TRANSLATION_PROVIDER_API_KEY=
TRANSLATION_PROVIDER_REGION=

# Optional. Only set this if the Azure resource does not answer on the global
# host — a geography-specific or private-endpoint resource. Leave blank for an
# ordinary global Translator resource.
# Example: https://api.cognitive.microsofttranslator.com
TRANSLATION_PROVIDER_ENDPOINT=

# Provider to route through: "azure" (default) or "fake".
# "fake" is a deterministic offline stand-in for local development and tests.
TRANSLATION_PROVIDER=azure

# HTTP port. Defaults to 8787.
PORT=8787

# Requests allowed per client per window.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Conversational language practice, over OpenAI.
#
# Optional. Leave blank and /tutor answers 503 while translation carries on
# exactly as before — practice is an extra, not the product.
#
# SECURITY: unlike the Azure credential, this one bills with no hard cap. A
# key that escapes is an invoice rather than a throttle, so it lives here and
# is never sent to, or embedded in, the mobile app.
OPENAI_API_KEY=

# Which model answers. Defaults to gpt-4o-mini — small and cheap, because this
# is short conversational practice rather than reasoning.
TUTOR_MODEL=gpt-4o-mini

# Caps the reply length, which caps the per-request cost.
TUTOR_MAX_TOKENS=220

# Far tighter than the translation limit above, and per hour rather than per
# minute. This is the first line of defence against a leaked build.
TUTOR_RATE_LIMIT_MAX=20
TUTOR_RATE_LIMIT_WINDOW_MS=3600000
