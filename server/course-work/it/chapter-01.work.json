  {
   "title": "Where Are You From?",
   "items": [
    {
     "text": "Io sono di...",
     "meaning": "I am from...",
     "example": "Io sono di Roma.",
     "exampleMeaning": "I am from Rome."
    },
    {
     "text": "Sei di...?",
     "meaning": "Are you from...?",
     "example": "Sei di Milano?",
     "exampleMeaning": "Are you from Milan?"
    },
    {
     "text": "Sì, sono di...",
     "meaning": "Yes, I am from...",
     "example": "Sì, sono di Napoli.",
     "exampleMeaning": "Yes, I am from Naples."
    },
    {
     "text": "No, non sono di...",
     "meaning": "No, I am not from...",
     "example": "No, non sono di Firenze.",
     "exampleMeaning": "No, I am not from Florence."
    },
    {
     "text": "Lavoro a...",
     "meaning": "I work in...",
     "example": "Lavoro a Torino.",
     "exampleMeaning": "I work in Turin."
    },
    {
     "text": "Vivo a...",
     "meaning": "I live in...",
     "example": "Vivo a Bologna.",
     "exampleMeaning": "I live in Bologna."
    }
   ],
   "tip": "To say where you are from, use 'Io sono di...'. You can also say where you live with 'Vivo a...'.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Sei di Milano?",
     "meaning": "Are you from Milan?"
    },
