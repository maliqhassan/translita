     "meaning": "No, I am not from Milan."
    },
    {
     "speaker": "A",
     "text": "Io sono di Roma.",
     "meaning": "I am from Rome."
    },
    {
     "speaker": "B",
     "text": "Sì, sono di Napoli.",
     "meaning": "Yes, I am from Naples."
    },
    {
     "speaker": "A",
     "text": "Lavoro a Torino.",
     "meaning": "I work in Turin."
    },
    {
     "speaker": "B",
     "text": "Vivo a Bologna.",
     "meaning": "I live in Bologna."
    }
   ],
   "scenario": {
    "partnerRole": "You are talking to someone about where they are from.",
    "learnerRole": "You are sharing your origin and where you live.",
    "brief": "Ask the learner where they are from and share your own origin.",
    "goal": "You will ask and answer questions about where you are from."
   }
