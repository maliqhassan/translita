   "title": "Talking About the Past",
   "checkpoint": false,
   "items": [
    {
     "id": "c12-d1-i1",
     "text": "ho visto",
     "meaning": "I saw",
     "example": "Ieri ho visto un film.",
     "exampleMeaning": "Yesterday I saw a movie."
    },
    {
     "id": "c12-d1-i2",
     "text": "mi è piaciuto",
     "meaning": "I liked it",
     "example": "Il film mi è piaciuto molto.",
     "exampleMeaning": "I really liked the movie."
    },
    {
     "id": "c12-d1-i3",
     "text": "ho fatto",
     "meaning": "I did",
     "example": "Ho fatto una passeggiata.",
     "exampleMeaning": "I took a walk."
    },
    {
     "id": "c12-d1-i4",
     "text": "è stato interessante",
     "meaning": "It was interesting",
     "example": "Il libro è stato interessante.",
     "exampleMeaning": "The book was interesting."
    },
    {
     "id": "c12-d1-i5",
     "text": "ho mangiato",
     "meaning": "I ate",
     "example": "Ho mangiato una pizza.",
     "exampleMeaning": "I ate a pizza."
    },
    {
     "id": "c12-d1-i6",
     "text": "ho comprato",
     "meaning": "I bought",
     "example": "Ho comprato un regalo.",
     "exampleMeaning": "I bought a gift."
    }
   ],
   "tip": "In Italian, the past tense often uses 'ho' plus the past participle of the verb. Remember to match the past participle with the subject's gender and number when needed.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Cosa hai fatto ieri?",
     "meaning": "What did you do yesterday?"
    },
    {
     "speaker": "B",
     "text": "Ho visto un film.",
     "meaning": "I saw a movie."
    },
    {
     "speaker": "A",
     "text": "Ti è piaciuto?",
     "meaning": "Did you like it?"
    },
    {
     "speaker": "B",
     "text": "Sì, mi è piaciuto.",
     "meaning": "Yes, I liked it."
    },
    {
     "speaker": "A",
     "text": "Hai mangiato qualcosa?",
     "meaning": "Did you eat something?"
    },
    {
     "speaker": "B",
     "text": "Sì, ho mangiato una pizza.",
     "meaning": "Yes, I ate a pizza."
    }
   ],
   "scenario": {
    "partnerRole": "Your friend who is curious about your recent activities.",
    "learnerRole": "You, sharing your experiences from yesterday.",
    "brief": "Ask your friend about their day and share what you did. Use the past tense for your actions.",
    "goal": "You will talk about what you did yesterday."
   }
