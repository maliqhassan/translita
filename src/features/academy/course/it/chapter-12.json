     "example": "Non mi è piaciuto il film.",
     "exampleMeaning": "I didn't like the movie."
    },
    {
     "id": "c12-d2-i3",
     "text": "è noioso",
     "meaning": "It is boring",
     "example": "Questo libro è noioso.",
     "exampleMeaning": "This book is boring."
    },
    {
     "id": "c12-d2-i4",
     "text": "è divertente",
     "meaning": "It is fun",
     "example": "Il gioco è divertente.",
     "exampleMeaning": "The game is fun."
    },
    {
     "id": "c12-d2-i5",
     "text": "preferisco",
     "meaning": "I prefer",
     "example": "Preferisco il tè al caffè.",
     "exampleMeaning": "I prefer tea to coffee."
    },
    {
     "id": "c12-d2-i6",
     "text": "mi sembra che",
     "meaning": "It seems to me that",
     "example": "Mi sembra che tu sia stanco.",
     "exampleMeaning": "It seems to me that you are tired."
    }
   ],
   "tip": "When expressing opinions, you can start with phrases like 'penso che' or 'mi sembra che'. This helps you share your thoughts clearly.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Cosa pensi del film?",
     "meaning": "What do you think of the movie?"
    },
    {
     "speaker": "B",
     "text": "Penso che sia interessante.",
     "meaning": "I think it is interesting."
    },
    {
     "speaker": "A",
     "text": "E il libro?",
     "meaning": "And the book?"
    },
    {
     "speaker": "B",
     "text": "Non mi è piaciuto.",
     "meaning": "I didn't like it."
    },
    {
     "speaker": "A",
     "text": "Perché?",
     "meaning": "Why?"
    },
    {
     "speaker": "B",
     "text": "È noioso.",
     "meaning": "It is boring."
    }
   ],
   "scenario": {
    "partnerRole": "A friend who wants to know your opinions on movies and books.",
    "learnerRole": "You, sharing your thoughts.",
    "brief": "Discuss your opinions on a movie and a book you recently experienced.",
    "goal": "You will express your opinions clearly."
   }
