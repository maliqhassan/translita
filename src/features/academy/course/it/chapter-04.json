   "title": "Giving Directions",
   "checkpoint": false,
   "items": [
    {
     "id": "c04-d2-i1",
     "text": "vai",
     "meaning": "go (imperative)",
     "example": "Vai dritto.",
     "exampleMeaning": "Go straight."
    },
    {
     "id": "c04-d2-i2",
