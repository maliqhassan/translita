     "text": "dove",
     "meaning": "where",
     "example": "Dove è la stazione?",
     "exampleMeaning": "Where is the station?"
    },
    {
     "id": "c04-d1-i2",
     "text": "la stazione",
     "meaning": "the station",
     "example": "La stazione è lontana.",
     "exampleMeaning": "The station is far."
    },
    {
     "id": "c04-d1-i3",
     "text": "il ristorante",
     "meaning": "the restaurant",
     "example": "Il ristorante è vicino.",
     "exampleMeaning": "The restaurant is near."
    },
    {
     "id": "c04-d1-i4",
     "text": "la piazza",
     "meaning": "the square",
     "example": "La piazza è bella.",
     "exampleMeaning": "The square is beautiful."
    },
    {
     "id": "c04-d1-i5",
     "text": "a sinistra",
     "meaning": "to the left",
     "example": "Vai a sinistra.",
     "exampleMeaning": "Go to the left."
    },
    {
     "id": "c04-d1-i6",
     "text": "a destra",
     "meaning": "to the right",
     "example": "Gira a destra.",
     "exampleMeaning": "Turn to the right."
    }
   ],
   "tip": "Use 'dove' to ask for the location of places. Remember to use the definite articles 'la' and 'il' for feminine and masculine nouns.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Dove è la stazione?",
     "meaning": "Where is the station?"
    },
    {
