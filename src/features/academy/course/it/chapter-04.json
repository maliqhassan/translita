     "speaker": "A",
     "text": "No, è vicino.",
     "meaning": "No, it is near."
    },
    {
     "speaker": "B",
     "text": "Dove posso trovare il ristorante?",
     "meaning": "Where can I find the restaurant?"
    },
    {
     "speaker": "A",
     "text": "Il ristorante è a sinistra.",
     "meaning": "The restaurant is to the left."
    },
    {
     "speaker": "B",
     "text": "Grazie!",
     "meaning": "Thank you!"
    }
   ],
   "scenario": {
