     "meaning": "turn (imperative)",
     "example": "Gira a sinistra.",
     "exampleMeaning": "Turn to the left."
    },
    {
     "id": "c04-d2-i3",
     "text": "prendi",
     "meaning": "take (imperative)",
     "example": "Prendi la seconda strada.",
     "exampleMeaning": "Take the second street."
    },
    {
     "id": "c04-d2-i4",
     "text": "dritto",
     "meaning": "straight",
     "example": "Vai dritto per due isolati.",
     "exampleMeaning": "Go straight for two blocks."
    },
    {
     "id": "c04-d2-i5",
     "text": "lì",
     "meaning": "there",
     "example": "Il ristorante è lì.",
     "exampleMeaning": "The restaurant is there."
    },
    {
     "id": "c04-d2-i6",
     "text": "subito",
     "meaning": "right away",
     "example": "Vai subito a destra.",
     "exampleMeaning": "Go right away to the right."
    }
   ],
   "tip": "Use the imperative form to give directions. It is direct and clear. Use 'vai', 'gira', and 'prendi' for commands.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Come arrivo al ristorante?",
     "meaning": "How do I get to the restaurant?"
    },
    {
     "speaker": "B",
     "text": "Vai dritto.",
     "meaning": "Go straight."
    },
    {
     "speaker": "A",
     "text": "E poi?",
     "meaning": "And then?"
    },
    {
     "speaker": "B",
     "text": "Gira a destra.",
     "meaning": "Turn to the right."
    },
    {
     "speaker": "A",
     "text": "Dove è il ristorante?",
     "meaning": "Where is the restaurant?"
    },
    {
     "speaker": "B",
     "text": "Il ristorante è lì.",
     "meaning": "The restaurant is there."
    }
   ],
   "scenario": {
    "partnerRole": "A local person",
    "learnerRole": "B, a tourist",
    "brief": "You are giving directions to a tourist who wants to reach the restaurant. Use imperative forms to guide them.",
    "goal": "You need to clearly explain how to get to the restaurant."
   }
