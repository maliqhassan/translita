     "meaning": "No, but I want to go there!"
    },
    {
     "speaker": "A",
     "text": "Det skulle vara roligt!",
     "meaning": "That would be fun!"
    },
    {
     "speaker": "B",
     "text": "Ja, verkligen!",
     "meaning": "Yes, really!"
    }
   ],
   "scenario": {
    "partnerRole": "You are talking about your home countries.",
