 "lessons": [
  {
   "id": "c01-d1",
   "day": 1,
   "title": "Hello and Goodbye",
   "checkpoint": false,
   "items": [
    {
     "id": "c01-d1-i1",
     "text": "Hej",
     "meaning": "Hello",
     "example": "Hej, hur mår du?",
     "exampleMeaning": "Hello, how are you?"
    },
    {
     "id": "c01-d1-i2",
     "text": "Adjö",
     "meaning": "Goodbye",
     "example": "Adjö, vi ses snart.",
     "exampleMeaning": "Goodbye, see you soon."
    },
    {
     "id": "c01-d1-i3",
     "text": "God morgon",
     "meaning": "Good morning",
     "example": "God morgon! Har du sovit bra?",
     "exampleMeaning": "Good morning! Did you sleep well?"
    },
    {
     "id": "c01-d1-i4",
     "text": "God kväll",
     "meaning": "Good evening",
     "example": "God kväll! Vad gör du?",
     "exampleMeaning": "Good evening! What are you doing?"
    },
    {
     "id": "c01-d1-i5",
     "text": "Tack",
     "meaning": "Thank you",
     "example": "Tack för hjälpen!",
     "exampleMeaning": "Thank you for the help!"
    },
    {
     "id": "c01-d1-i6",
     "text": "Varsågod",
     "meaning": "You're welcome",
     "example": "Varsågod, det var inget.",
     "exampleMeaning": "You're welcome, it was nothing."
    }
   ],
   "tip": "Use 'Hej' for informal greetings. 'God morgon' is used in the morning, while 'God kväll' is for the evening.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Hej!",
     "meaning": "Hello!"
    },
    {
     "speaker": "B",
     "text": "Hej! Hur mår du?",
     "meaning": "Hello! How are you?"
    },
    {
     "speaker": "A",
     "text": "Jag mår bra, tack!",
     "meaning": "I am good, thank you!"
    },
    {
     "speaker": "B",
     "text": "Vad bra! God morgon!",
     "meaning": "That's good! Good morning!"
    },
    {
     "speaker": "A",
     "text": "God morgon! Adjö!",
     "meaning": "Good morning! Goodbye!"
    },
    {
     "speaker": "B",
     "text": "Adjö!",
     "meaning": "Goodbye!"
    }
   ],
   "scenario": {
    "partnerRole": "You are a friendly person greeting someone.",
    "learnerRole": "You are meeting a new person.",
    "brief": "Hälsa på den nya personen. Fråga hur de mår och säg god morgon.",
    "goal": "You will greet the person and ask how they are."
   }
  },
  {
   "id": "c01-d2",
   "day": 2,
   "title": "My Name is...",
   "checkpoint": false,
   "items": [
    {
     "id": "c01-d2-i1",
     "text": "Jag heter...",
     "meaning": "My name is...",
     "example": "Jag heter Anna.",
     "exampleMeaning": "My name is Anna."
    },
    {
     "id": "c01-d2-i2",
     "text": "Vad heter du?",
     "meaning": "What is your name?",
     "example": "Vad heter du?",
     "exampleMeaning": "What is your name?"
    },
    {
     "id": "c01-d2-i3",
     "text": "Trevligt att träffas!",
     "meaning": "Nice to meet you!",
     "example": "Trevligt att träffas, Anna!",
     "exampleMeaning": "Nice to meet you, Anna!"
    },
    {
     "id": "c01-d2-i4",
     "text": "Jag är från...",
     "meaning": "I am from...",
     "example": "Jag är från Sverige.",
     "exampleMeaning": "I am from Sweden."
    },
    {
