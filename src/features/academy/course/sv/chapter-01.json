     "meaning": "I come from...",
     "example": "Jag kommer från England.",
     "exampleMeaning": "I come from England."
    }
   ],
   "tip": "When introducing yourself, use 'Jag heter...' followed by your name. To ask someone their name, say 'Vad heter du?'",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Vad heter du?",
     "meaning": "What is your name?"
    },
    {
     "speaker": "B",
     "text": "Jag heter Alex.",
     "meaning": "My name is Alex."
    },
    {
     "speaker": "A",
     "text": "Trevligt att träffas, Alex!",
     "meaning": "Nice to meet you, Alex!"
    },
    {
     "speaker": "B",
     "text": "Trevligt att träffas!",
     "meaning": "Nice to meet you!"
    },
    {
     "speaker": "A",
     "text": "Varifrån är du?",
     "meaning": "Where are you from?"
    },
    {
     "speaker": "B",
     "text": "Jag kommer från Kanada.",
     "meaning": "I come from Canada."
    }
   ],
   "scenario": {
    "partnerRole": "You are meeting someone new.",
    "learnerRole": "You are introducing yourself.",
    "brief": "Fråga efter namnet och var de kommer ifrån.",
    "goal": "You will introduce yourself and ask for their name."
   }
  },
