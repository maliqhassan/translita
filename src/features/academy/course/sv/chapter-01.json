  },
  {
   "id": "c01-d4",
   "day": 4,
   "title": "Using 'To Be'",
   "checkpoint": false,
   "items": [
    {
     "id": "c01-d4-i1",
     "text": "Jag är...",
     "meaning": "I am...",
     "example": "Jag är trött.",
     "exampleMeaning": "I am tired."
    },
    {
     "id": "c01-d4-i2",
     "text": "Du är...",
     "meaning": "You are...",
     "example": "Du är snäll.",
     "exampleMeaning": "You are kind."
    },
    {
     "id": "c01-d4-i3",
     "text": "Han är...",
     "meaning": "He is...",
     "example": "Han är glad.",
     "exampleMeaning": "He is happy."
    },
    {
     "id": "c01-d4-i4",
     "text": "Hon är...",
     "meaning": "She is...",
     "example": "Hon är intelligent.",
     "exampleMeaning": "She is intelligent."
    },
    {
     "id": "c01-d4-i5",
     "text": "Vi är...",
     "meaning": "We are...",
     "example": "Vi är vänner.",
     "exampleMeaning": "We are friends."
    },
    {
     "id": "c01-d4-i6",
     "text": "De är...",
     "meaning": "They are...",
     "example": "De är här.",
     "exampleMeaning": "They are here."
    }
   ],
   "tip": "The verb 'att vara' (to be) is important in Swedish. Use 'Jag är' for 'I am', 'Du är' for 'You are', and so on.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Jag är glad!",
     "meaning": "I am happy!"
    },
    {
     "speaker": "B",
     "text": "Vad bra! Du är snäll.",
     "meaning": "That's good! You are kind."
    },
    {
     "speaker": "A",
     "text": "Hon är trött.",
     "meaning": "She is tired."
    },
    {
     "speaker": "B",
     "text": "Ja, men de är här.",
     "meaning": "Yes, but they are here."
    },
    {
     "speaker": "A",
     "text": "Vi är vänner.",
     "meaning": "We are friends."
    },
    {
     "speaker": "B",
     "text": "Ja, det är vi!",
     "meaning": "Yes, we are!"
    }
   ],
   "scenario": {
    "partnerRole": "You are chatting with a friend.",
    "learnerRole": "You are sharing feelings and states.",
    "brief": "Prata om hur ni mår och vad ni är.",
    "goal": "You will express how you feel and what you are."
   }
  },
