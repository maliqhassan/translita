{
 "id": "c01",
 "number": 1,
 "title": "Greetings and Introductions",
 "lessons": [
  {
   "id": "c01-d1",
   "day": 1,
   "title": "Hello and Goodbye",
   "checkpoint": false,
   "items": [
    {
     "id": "c01-d1-i1",
     "text": "'Hola'",
     "meaning": "Hello",
     "example": "'Hola, ¿cómo estás?','Hello, how are you?'",
     "exampleMeaning": "Hello, how are you?"
    },
    {
     "id": "c01-d1-i2",
     "text": "'Adiós'",
     "meaning": "Goodbye",
     "example": "'Adiós, hasta luego.','Goodbye, see you later.'",
     "exampleMeaning": "Goodbye, see you later."
    },
    {
     "id": "c01-d1-i3",
     "text": "'Buenos días'",
     "meaning": "Good morning",
     "example": "'Buenos días, señora.','Good morning, ma'am.'",
     "exampleMeaning": "Good morning, ma'am."
    },
    {
     "id": "c01-d1-i4",
     "text": "'Buenas tardes'",
     "meaning": "Good afternoon",
     "example": "'Buenas tardes, amigos.','Good afternoon, friends.'",
     "exampleMeaning": "Good afternoon, friends."
    },
    {
     "id": "c01-d1-i5",
     "text": "'Buenas noches'",
     "meaning": "Good evening / Good night",
     "example": "'Buenas noches, ¿cómo fue tu día?','Good evening, how was your day?'",
     "exampleMeaning": "Good evening, how was your day?"
    },
    {
     "id": "c01-d1-i6",
     "text": "'¿Cómo estás?'",
     "meaning": "How are you?",
     "example": "'¿Cómo estás? Estoy bien.','How are you? I am fine.'",
     "exampleMeaning": "How are you? I am fine."
    }
   ],
   "tip": "Use 'Hola' at any time of day. 'Buenos días' is used in the morning, 'Buenas tardes' in the afternoon, and 'Buenas noches' in the evening.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "'Hola, ¿cómo te llamas?'",
     "meaning": "Hello, what is your name?"
    },
    {
     "speaker": "B",
     "text": "'Hola, me llamo Alex.'",
     "meaning": "Hello, my name is Alex."
    },
    {
     "speaker": "A",
     "text": "'Mucho gusto, Alex.'",
     "meaning": "Nice to meet you, Alex."
    },
    {
     "speaker": "B",
     "text": "'Mucho gusto.'",
     "meaning": "Nice to meet you."
    },
    {
     "speaker": "A",
     "text": "'¿De dónde eres?'",
     "meaning": "Where are you from?"
    },
    {
     "speaker": "B",
     "text": "'Soy de México.'",
     "meaning": "I am from Mexico."
    }
   ],
   "scenario": {
    "partnerRole": "A is a friendly person meeting you.",
    "learnerRole": "You are Alex from Mexico.",
    "brief": "A greets you and asks your name and where you are from. Respond politely.",
    "goal": "You should introduce yourself and say where you are from."
   }
  },
  {
   "id": "c01-d2",
   "day": 2,
   "title": "Using 'To Be'",
   "checkpoint": false,
   "items": [
    {
     "id": "c01-d2-i1",
     "text": "'Soy'",
     "meaning": "I am",
     "example": "'Soy estudiante.','I am a student.'",
     "exampleMeaning": "I am a student."
    },
    {
     "id": "c01-d2-i2",
     "text": "'Eres'",
     "meaning": "You are (informal)",
     "example": "'Eres mi amigo.','You are my friend.'",
     "exampleMeaning": "You are my friend."
    },
    {
     "id": "c01-d2-i3",
     "text": "'Es'",
     "meaning": "He/She is / It is",
     "example": "'Es mi hermana.','She is my sister.'",
     "exampleMeaning": "She is my sister."
    },
    {
     "id": "c01-d2-i4",
     "text": "'Somos'",
     "meaning": "We are",
     "example": "'Somos compañeros.','We are classmates.'",
     "exampleMeaning": "We are classmates."
    },
    {
     "id": "c01-d2-i5",
     "text": "'Son'",
     "meaning": "They are / You are (formal)",
     "example": "'Son mis padres.','They are my parents.'",
     "exampleMeaning": "They are my parents."
    },
    {
     "id": "c01-d2-i6",
     "text": "'¿Eres de aquí?'",
     "meaning": "Are you from here?",
     "example": "'¿Eres de aquí? Soy de México.','Are you from here? I am from Mexico.'",
     "exampleMeaning": "Are you from here? I am from Mexico."
    }
   ],
   "tip": "Use 'soy' for yourself, 'eres' for friends, and 'es' for others. 'Son' is for plural subjects.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "'¿Eres de aquí?'",
     "meaning": "Are you from here?"
    },
    {
     "speaker": "B",
     "text": "'No, soy de México.'",
     "meaning": "No, I am from Mexico."
    },
    {
     "speaker": "A",
     "text": "'¿Eres estudiante?'",
     "meaning": "Are you a student?"
    },
    {
     "speaker": "B",
     "text": "'Sí, soy estudiante.'",
     "meaning": "Yes, I am a student."
    },
    {
     "speaker": "A",
     "text": "'¿Y tú, de dónde eres?'",
     "meaning": "And you, where are you from?"
    },
    {
     "speaker": "B",
     "text": "'Soy de México.'",
     "meaning": "I am from Mexico."
    }
   ],
   "scenario": {
    "partnerRole": "A is curious about your background.",
    "learnerRole": "You are a student from Mexico.",
    "brief": "A asks you if you are from here and about your studies. Respond with your information.",
    "goal": "You should explain where you are from and your student status."
   }
  },
  {
   "id": "c01-d3",
   "day": 3,
   "title": "Talking About Yourself",
   "checkpoint": false,
   "items": [
    {
     "id": "c01-d3-i1",
     "text": "'Me llamo'",
     "meaning": "My name is",
     "example": "'Me llamo María.','My name is Maria.'",
     "exampleMeaning": "My name is Maria."
    },
    {
     "id": "c01-d3-i2",
     "text": "'Tengo'",
     "meaning": "I have",
     "example": "'Tengo un perro.','I have a dog.'",
     "exampleMeaning": "I have a dog."
    },
    {
     "id": "c01-d3-i3",
     "text": "'Vivo'",
     "meaning": "I live",
     "example": "'Vivo en la ciudad.','I live in the city.'",
     "exampleMeaning": "I live in the city."
    },
    {
     "id": "c01-d3-i4",
     "text": "'Tengo ... años'",
     "meaning": "I am ... years old",
     "example": "'Tengo veinte años.','I am twenty years old.'",
     "exampleMeaning": "I am twenty years old."
    },
    {
     "id": "c01-d3-i5",
     "text": "'Soy de'",
     "meaning": "I am from",
     "example": "'Soy de España.','I am from Spain.'",
     "exampleMeaning": "I am from Spain."
    },
    {
     "id": "c01-d3-i6",
     "text": "'¿Cuántos años tienes?'",
     "meaning": "How old are you?",
     "example": "'¿Cuántos años tienes? Tengo veinte años.','How old are you? I am twenty years old.'",
     "exampleMeaning": "How old are you? I am twenty years old."
    }
   ],
   "tip": "Use 'Me llamo' to introduce your name. 'Tengo' is used for age and possessions.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "'¿Cuántos años tienes?'",
     "meaning": "How old are you?"
    },
    {
     "speaker": "B",
     "text": "'Tengo veinticinco años.'",
     "meaning": "I am twenty-five years old."
    },
    {
     "speaker": "A",
     "text": "'¿Te llamas María?'",
     "meaning": "Is your name Maria?"
    },
    {
     "speaker": "B",
     "text": "'No, me llamo Alex.'",
     "meaning": "No, my name is Alex."
    },
    {
     "speaker": "A",
     "text": "'¿Dónde vives?'",
     "meaning": "Where do you live?"
    },
    {
     "speaker": "B",
     "text": "'Vivo en México.'",
     "meaning": "I live in Mexico."
    }
   ],
   "scenario": {
    "partnerRole": "A wants to learn more about you.",
    "learnerRole": "You are Alex, living in Mexico.",
    "brief": "A asks about your age, name, and where you live. Respond with your details.",
    "goal": "You should share your name, age, and where you live."
   }
  },
  {
   "id": "c01-d4",
   "day": 4,
   "title": "Where Are You From?",
   "checkpoint": false,
   "items": [
    {
     "id": "c01-d4-i1",
     "text": "'¿De dónde eres?'",
     "meaning": "Where are you from?",
     "example": "'¿De dónde eres? Soy de Perú.','Where are you from? I am from Peru.'",
     "exampleMeaning": "Where are you from? I am from Peru."
    },
    {
     "id": "c01-d4-i2",
     "text": "'Soy de ...'",
     "meaning": "I am from ...",
     "example": "'Soy de Argentina.','I am from Argentina.'",
     "exampleMeaning": "I am from Argentina."
    },
    {
     "id": "c01-d4-i3",
     "text": "'¿Y tú?'",
     "meaning": "And you?",
     "example": "'Soy de Brasil. ¿Y tú?','I am from Brazil. And you?'",
     "exampleMeaning": "I am from Brazil. And you?"
    },
    {
     "id": "c01-d4-i4",
     "text": "'¿Eres de ...?'",
     "meaning": "Are you from ...?",
     "example": "'¿Eres de Colombia?','Are you from Colombia?'",
     "exampleMeaning": "Are you from Colombia?"
    },
    {
     "id": "c01-d4-i5",
     "text": "'Sí, soy de ...'",
     "meaning": "Yes, I am from ...",
     "example": "'Sí, soy de Chile.','Yes, I am from Chile.'",
     "exampleMeaning": "Yes, I am from Chile."
    },
    {
     "id": "c01-d4-i6",
     "text": "'No, no soy de ...'",
     "meaning": "No, I am not from ...",
     "example": "'No, no soy de México.','No, I am not from Mexico.'",
     "exampleMeaning": "No, I am not from Mexico."
    }
   ],
   "tip": "Use '¿De dónde eres?' to ask someone where they are from. You can respond with 'Soy de ...'.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "'¿De dónde eres?'",
     "meaning": "Where are you from?"
    },
    {
     "speaker": "B",
     "text": "'Soy de Colombia.'",
     "meaning": "I am from Colombia."
    },
    {
     "speaker": "A",
     "text": "'¿Eres de aquí?'",
     "meaning": "Are you from here?"
    },
    {
     "speaker": "B",
     "text": "'No, no soy de aquí.'",
     "meaning": "No, I am not from here."
    },
    {
     "speaker": "A",
     "text": "'¿Y tú, de dónde eres?'",
     "meaning": "And you, where are you from?"
    },
    {
     "speaker": "B",
     "text": "'Soy de Perú.'",
     "meaning": "I am from Peru."
    }
   ],
   "scenario": {
    "partnerRole": "A is curious about your origin.",
    "learnerRole": "You are from Colombia or Peru.",
    "brief": "A asks where you are from and if you are from there. Respond with your origin.",
    "goal": "You should explain where you are from."
   }
  },
