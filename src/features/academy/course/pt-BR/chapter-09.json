  {
   "id": "c09-d2",
   "day": 42,
   "title": "What Hurts?",
   "checkpoint": false,
   "items": [
    {
     "id": "c09-d2-i1",
     "text": "dói",
     "meaning": "hurts",
     "example": "Onde dói?",
     "exampleMeaning": "Where does it hurt?"
    },
    {
     "id": "c09-d2-i2",
     "text": "a dor",
     "meaning": "the pain",
     "example": "A dor é forte.",
     "exampleMeaning": "The pain is strong."
    },
    {
     "id": "c09-d2-i3",
     "text": "a consulta",
     "meaning": "the appointment",
     "example": "Eu tenho uma consulta médica.",
     "exampleMeaning": "I have a doctor's appointment."
    },
    {
     "id": "c09-d2-i4",
     "text": "o remédio",
     "meaning": "the medicine",
     "example": "Eu preciso de remédio.",
     "exampleMeaning": "I need medicine."
    },
    {
     "id": "c09-d2-i5",
     "text": "o médico",
     "meaning": "the doctor",
     "example": "O médico vai me ajudar.",
     "exampleMeaning": "The doctor will help me."
    },
    {
     "id": "c09-d2-i6",
     "text": "a receita",
     "meaning": "the prescription",
     "example": "Eu preciso da receita.",
     "exampleMeaning": "I need the prescription."
    }
   ],
   "tip": "When saying what hurts, use 'dói' with the body part. For example, 'A cabeça dói' means 'The head hurts.' This structure is common.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "Onde dói?",
     "meaning": "Where does it hurt?"
    },
    {
     "speaker": "B",
     "text": "A dor é forte.",
     "meaning": "The pain is strong."
    },
    {
     "speaker": "A",
     "text": "Você tem uma consulta?",
     "meaning": "Do you have an appointment?"
    },
    {
     "speaker": "B",
     "text": "Sim, eu tenho uma consulta médica.",
     "meaning": "Yes, I have a doctor's appointment."
    },
    {
     "speaker": "A",
     "text": "Você já tomou remédio?",
     "meaning": "Have you taken medicine?"
    },
    {
     "speaker": "B",
     "text": "Não, eu preciso de remédio.",
     "meaning": "No, I need medicine."
    }
   ],
   "scenario": {
    "partnerRole": "a doctor",
    "learnerRole": "a patient",
    "brief": "You are at the doctor's office. The doctor asks you about your pain. Respond with where it hurts and if you have an appointment.",
    "goal": "You need to describe your pain to the doctor."
   }
  },
  {
