    {
     "id": "c09-d1-i6",
     "text": "o olho",
     "meaning": "the eye",
     "example": "Eu tenho um problema no olho.",
     "exampleMeaning": "I have a problem with my eye."
    }
   ],
   "tip": "In Brazilian Portuguese, nouns have genders. 'A' is used for feminine nouns and 'o' for masculine nouns. For example, 'a cabeça' (the head) is feminine, while 'o braço' (the arm) is masculine.",
   "dialogue": [
    {
     "speaker": "A",
     "text": "O que aconteceu?",
     "meaning": "What happened?"
    },
    {
     "speaker": "B",
     "text": "Eu estou com dor de cabeça.",
     "meaning": "I have a headache."
    },
    {
     "speaker": "A",
     "text": "E o que mais dói?",
     "meaning": "And what else hurts?"
    },
    {
     "speaker": "B",
     "text": "Meu braço dói.",
     "meaning": "My arm hurts."
    },
    {
     "speaker": "A",
     "text": "Você precisa descansar.",
     "meaning": "You need to rest."
    },
    {
     "speaker": "B",
     "text": "Sim, eu vou descansar.",
     "meaning": "Yes, I will rest."
    }
   ],
   "scenario": {
    "partnerRole": "a friend who is concerned about your health",
    "learnerRole": "someone who is not feeling well",
    "brief": "Your friend asks you about your health. Respond with what hurts and how you feel. Use the body parts you learned.",
    "goal": "You need to explain your symptoms."
   }
