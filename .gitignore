# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# native module build output (modules/*/android is source, its build/ is not)
modules/*/android/build/
modules/*/android/.cxx/

# unit test build output
.test-build/

# Local Expo Go APKs downloaded for device testing (very large binaries)
*.apk

# Backend build and secrets
server/dist/
server/.test-build/

# Environment files. Never commit real credentials.
.env
.env.local
.env.*.local

# Signing. The upload key and its passwords never go near the repository:
# anyone holding both can publish an update as you.
*.keystore
*.jks
android/keystore.properties
